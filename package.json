{
  "name": "jarvis-ai-assistant-api",
  "version": "1.0.0",
  "description": "Intelligent Jarvis AI Assistant API with NLP, task automation, and knowledge management",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "AI",
    "assistant",
    "Jarvis",
    "NLP",
    "task-automation",
    "API"
  ],
  "author": "Jarvis Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.0.3",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "express-validator": "^7.0.0",
    "axios": "^1.3.0",
    "openai": "^3.2.1",
    "redis": "^4.6.5",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^18.11.9",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/jest": "^29.2.4",
    "typescript": "^4.9.4",
    "ts-node": "^10.9.1",
    "jest": "^29.3.1",
    "ts-jest": "^29.0.3",
    "supertest": "^6.3.3",
    "@types/supertest": "^2.0.12",
    "eslint": "^8.31.0",
    "@typescript-eslint/eslint-plugin": "^5.48.0",
    "@typescript-eslint/parser": "^5.48.0",
    "prettier": "^2.8.1"
  }
}
